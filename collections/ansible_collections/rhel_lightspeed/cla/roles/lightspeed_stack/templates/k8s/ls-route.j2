kind: Route
apiVersion: route.openshift.io/v1
metadata:
  namespace: {{ ansible_operator_meta.namespace }}
  name: {{ ls_k8s_name }}
  labels:
    service: rhel-lightspeed
    app: {{ ls_k8s_name }}
spec:
  to:
    kind: Service
    name: {{ ls_service_name }}
  port:
    targetPort: http
  tls:
    termination: edge
