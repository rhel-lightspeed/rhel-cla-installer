apiVersion: v1
kind: Service
metadata:
  name: {{ pg_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-cla
    app: {{ pg_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  selector:
    app: {{ pg_name }}
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
      protocol: TCP
