apiVersion: v1
kind: Secret
metadata:
  name: {{ pg_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-cla
    app: {{ pg_name }}
    app.kubernetes.io/part-of: rhel-cla
type: Opaque
stringData:
  db.host: "{{ pg_name }}"
  db.port: "5432"
  db.name: "{{ pg_db_name }}"
  db.user: "{{ pg_db_user }}"
  db.password: "{{ pg_password }}"
