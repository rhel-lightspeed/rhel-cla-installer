apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ ls_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ ls_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  replicas: {{ ls_replicas }}
  selector:
    matchLabels:
      app: {{ ls_name }}
  template:
    metadata:
      labels:
        service: rhel-lightspeed
        app: {{ ls_name }}
        app.kubernetes.io/part-of: rhel-cla
    spec:
      serviceAccountName: {{ ls_name }}
      containers:
        - name: {{ ls_name }}
{% if ls_container_image_digest | default('') %}
          image: {{ ls_container_image }}@{{ ls_container_image_digest }}
{% else %}
          image: {{ ls_container_image }}:{{ ls_container_image_tag }}
{% endif %}
          imagePullPolicy: IfNotPresent
          args:
            - --config
            - /app-root/lightspeed-stack.yml
          ports:
            - name: http
              containerPort: {{ ls_port }}
              protocol: TCP
          env:
            - name: SQLITE_STORE_DIR
              value: /tmp/llama-store
{% if ls_auth_enabled | bool and ls_auth_module == 'api-key-token' %}
            - name: API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ ls_api_key_secret_name }}
                  key: {{ ls_api_key_secret_key }}
{% endif %}
{% if rhel_cla_provider == 'vertex' %}
            - name: GOOGLE_APPLICATION_CREDENTIALS
              value: /etc/gcp/{{ vertex_config.credentials_secret_key | default('credentials.json') }}
            - name: VERTEX_AI_PROJECT_ID
              value: "{{ vertex_config.project_id }}"
            - name: VERTEX_AI_LOCATION
              value: "{{ vertex_config.location | default('global') }}"
{% endif %}
{% if ls_use_postgres | bool %}
            - name: POSTGRES_HOST
              valueFrom:
                secretKeyRef:
                  name: {{ ls_postgres_secret_name }}
                  key: db.host
            - name: POSTGRES_PORT
              valueFrom:
                secretKeyRef:
                  name: {{ ls_postgres_secret_name }}
                  key: db.port
            - name: POSTGRES_DB
              valueFrom:
                secretKeyRef:
                  name: {{ ls_postgres_secret_name }}
                  key: db.name
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: {{ ls_postgres_secret_name }}
                  key: db.user
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ ls_postgres_secret_name }}
                  key: db.password
{% endif %}
          volumeMounts:
            - name: stack-config
              mountPath: /app-root/lightspeed-stack.yml
              subPath: lightspeed-stack.yml
              readOnly: true
            - name: stack-config
              mountPath: /app-root/llama-stack.yml
              subPath: llama-stack.yml
              readOnly: true
            - name: stack-config
              mountPath: /app-root/system_prompt.txt
              subPath: system_prompt.txt
              readOnly: true
{% if rhel_cla_provider == 'vertex' %}
            - name: gcp-credentials
              mountPath: /etc/gcp
              readOnly: true
{% endif %}
{% if ls_auth_enabled | bool and ls_auth_module == 'api-key-token' %}
          # skip_for_health_probes only matches bare /liveness|/readiness, not root_path.
          # Exec Bearer against ${env.API_KEY} so probes pass with api-key-token.
          livenessProbe:
            exec:
              command: ["/bin/sh", "-c", "curl -sf -H \"Authorization: Bearer $API_KEY\" http://127.0.0.1:{{ ls_port }}/api/lightspeed/liveness"]
            initialDelaySeconds: 20
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 8
          readinessProbe:
            exec:
              command: ["/bin/sh", "-c", "curl -sf -H \"Authorization: Bearer $API_KEY\" http://127.0.0.1:{{ ls_port }}/api/lightspeed/liveness"]
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 8
{% else %}
          livenessProbe:
            httpGet:
              path: /api/lightspeed/liveness
              port: http
            initialDelaySeconds: 15
            periodSeconds: 15
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: /api/lightspeed/liveness
              port: http
            initialDelaySeconds: 10
            periodSeconds: 15
            failureThreshold: 5
{% endif %}
          resources:
            requests:
              cpu: {{ ls_cpu_request }}
              memory: {{ ls_memory_request }}
            limits:
              cpu: {{ ls_cpu_limit }}
              memory: {{ ls_memory_limit }}
      volumes:
        - name: stack-config
          configMap:
            name: {{ ls_name }}-config
{% if rhel_cla_provider == 'vertex' %}
        - name: gcp-credentials
          secret:
            secretName: {{ vertex_config.credentials_secret_name }}
{% endif %}
