# {{ ansible_managed }}
[Unit]
Description=Lightspeed Stack

[Container]
Image={{ ls_name }}.image
ContainerName={{ ls_name }}
Pod={{ cla_pod_name }}.pod

Volume={{ ls_config_dir }}/lightspeed-stack-{{ _ls_major_version }}.yml:/app-root/lightspeed-stack.yaml:Z
Volume={{ ls_config_dir }}/run.yml:/app-root/run.yaml:Z
Volume={{ ls_config_dir }}/system_prompt.txt:/app-root/system_prompt.txt:Z

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
