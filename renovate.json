{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ansible-galaxy": {
    "enabled": false
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/Containerfile/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the rpm-lockfile-prototype context image in sync with the Containerfile builder image",
      "managerFilePatterns": [
        "/^\\.konflux/rpms/rpms\\.in\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "redhat"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "versioning": "redhat"
    },
    {
      "description": "Ship builder and runtime base image updates together, quickly: they usually carry CVE fixes",
      "matchDepNames": [
        "registry.access.redhat.com/hi/python",
        "registry.access.redhat.com/ubi10-minimal"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "groupName": "container base images",
      "groupSlug": "container-base-images",
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"]
    }
  ]
}
